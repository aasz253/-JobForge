# ============================================================================
# JobForge — environment variables template
# Copy to `.env` and fill in. NEVER commit real secrets.
# ============================================================================

# --- Core --------------------------------------------------------------------
# SQLAlchemy database URL.
# SQLite (local default):   sqlite:///./jobforge.db
# PostgreSQL (docker):      postgresql+psycopg://jobforge:jobforge@db:5432/jobforge
DATABASE_URL=sqlite:///./jobforge.db

# Secret used to sign session tokens. Generate:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Session lifetime in seconds (default 7 days)
SESSION_LIFETIME=604800

# Comma-separated allowed CORS origins for the web app
CORS_ORIGINS=http://localhost:3000

# --- Branding ----------------------------------------------------------------
APP_NAME=JOBFORGE
APP_TAGLINE=Find. Qualify. Apply. Advance.
APP_MADE_BY=Sifuna Codex

# --- AI provider -------------------------------------------------------------
# none (default: rule-based, free) | local (Ollama) | openai_compatible
AI_PROVIDER=none

# Base URL for local / OpenAI-compatible endpoints (e.g. Ollama: http://localhost:11434/v1)
AI_BASE_URL=

# Optional API key for OpenAI-compatible providers
AI_API_KEY=

# Model identifier (e.g. qwen2.5-coder:7b, gpt-4o-mini)
AI_MODEL=

# Optional local embedding/base model settings
AI_LOCAL_MODEL=

# When true, the LLM is never called and rule-based analysis is used instead.
# Useful as a kill-switch regardless of provider config.
AI_DISABLED=false

# --- GitHub integration (optional) ------------------------------------------
# Personal access token, classic (repo:read) or fine-grained, with access ONLY to
# the repositories the user consents to share. `public` = unauthenticated public API.
GITHUB_TOKEN=
GITHUB_MODE=public

# --- Email integration (optional, OAuth read-only) ---------------------------
# Never store passwords. Placeholder values for the OAuth client.
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_REDIRECT_URI=http://localhost:8000/api/email/callback

# --- Encryption key for sensitive fields (Fernet key). Generate:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Security ----------------------------------------------------------------
# Comma-separated allowed hosts (behind proxy). Leave empty in dev.
ALLOWED_HOSTS=
# Rate limits (events per window)
RATE_LIMIT_LOGIN=20
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_IMPORT=30
RATE_LIMIT_IMPORT_WINDOW=600